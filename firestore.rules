rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@orascom.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      // Allow read so login queries by hrCode/phone/email can resolve
      allow read: if true;
      // Allow registration of new user documents
      allow create: if true;
      // Allow update for authenticated users, profile updates, and transparent password migration
      allow update: if true;
      // Only administrators can permanently delete users
      allow delete: if isAuthenticated();
    }

    // 2. Training Records (cleanedData & records)
    match /cleanedData/{recordId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    match /records/{recordId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Handout Revisions
    match /handoutRevisions/{revId} {
      // Must be authenticated to view or submit revisions
      allow read, write: if isAuthenticated();
    }

    // 4. Suggestions
    match /suggestions/{sugId} {
      // Must be authenticated to view suggestions
      allow read: if isAuthenticated();
      // Any user can submit feedback/suggestions
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 5. Courses, Sessions, Announcements, System Settings
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      // Allow creating/updating sessions (including registration)
      allow write: if true;
    }

    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // System Settings (globalKPIs, appConfig)
    match /systemSettings/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
