rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@orascom.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      // Allow read so login queries by hrCode/phone/email can resolve safely
      allow read: if true;
      
      // Allow registration: new users can only create trainee accounts with pending status
      allow create: if (request.resource.data.role == 'trainee' && request.resource.data.status == 'pending') || isAdmin();
      
      // Allow update: Regular users cannot escalate their role or self-approve status or change HR code
      allow update: if isAdmin() || (
        isAuthenticated() && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'hrCode', 'isShadowAccount'])
      );
      
      // Only administrators can permanently delete users
      allow delete: if isAdmin();
    }

    // 2. Training Records (cleanedData & records)
    match /cleanedData/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /records/{recordId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Handout Revisions
    match /handoutRevisions/{revId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 4. Suggestions
    match /suggestions/{sugId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 5. Courses & Sessions
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      // Admins can create/delete sessions; authenticated users can update (enroll/attend)
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() || isAdmin();
    }

    // 6. Announcements
    match /announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_announcements/{annId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. System Error Reports & Activity Logs
    match /error_reports/{errId} {
      allow read: if isAdmin();
      allow create: if true; // Allows ErrorBoundary to log client exceptions
      allow update, delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /login_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 8. System Settings
    match /systemSettings/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
